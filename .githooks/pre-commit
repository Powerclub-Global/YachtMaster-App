#!/bin/bash

# YachtMaster App Pre-Commit Hook
# Prevents committing sensitive data

set -e

echo "🔍 Running pre-commit security checks..."

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Track if we found any issues
FOUND_ISSUES=false

# Check for common secret patterns
echo "🔐 Checking for secrets..."

# Stripe keys
if git diff --cached --name-only | xargs grep -E "sk_live_[a-zA-Z0-9]{24,}" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: Stripe secret key detected!${NC}"
    echo "   Remove the secret key before committing."
    FOUND_ISSUES=true
fi

if git diff --cached --name-only | xargs grep -E "sk_test_[a-zA-Z0-9]{24,}" 2>/dev/null; then
    echo -e "${YELLOW}⚠️  WARNING: Stripe test key detected!${NC}"
    echo "   Consider using environment variables instead."
fi

# Firebase keys
if git diff --cached --name-only | xargs grep -E "AIza[0-9A-Za-z_-]{35}" 2>/dev/null; then
    echo -e "${YELLOW}⚠️  WARNING: Possible Firebase API key detected!${NC}"
    echo "   Ensure this is intentional (client-side keys are okay)."
fi

# AWS keys
if git diff --cached --name-only | xargs grep -E "AKIA[0-9A-Z]{16}" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: AWS Access Key detected!${NC}"
    FOUND_ISSUES=true
fi

# Private keys
if git diff --cached --name-only | xargs grep -E "BEGIN.*PRIVATE KEY" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: Private key detected!${NC}"
    FOUND_ISSUES=true
fi

# Generic secrets
if git diff --cached --name-only | xargs grep -iE "(password|passwd|pwd)\s*=\s*['\"][^'\"]{8,}" 2>/dev/null; then
    echo -e "${YELLOW}⚠️  WARNING: Possible hardcoded password detected!${NC}"
fi

# Check for forbidden files
echo "📁 Checking for forbidden files..."

FORBIDDEN_FILES=(
    "*.key"
    "*.pem"
    "*.p12"
    "*.jks"
    "*.keystore"
    ".env"
    "key.properties"
    "google-services.json"
    "GoogleService-Info.plist"
)

for pattern in "${FORBIDDEN_FILES[@]}"; do
    if git diff --cached --name-only | grep -q "$pattern"; then
        echo -e "${RED}❌ ERROR: Forbidden file detected: $pattern${NC}"
        echo "   This file should be in .gitignore"
        FOUND_ISSUES=true
    fi
done

# Check for TODOs in critical files (optional)
echo "📝 Checking for critical TODOs..."

CRITICAL_TODOS=$(git diff --cached --name-only | grep -E "(payment|auth|security)" | xargs grep -n "TODO" 2>/dev/null || true)

if [ -n "$CRITICAL_TODOS" ]; then
    echo -e "${YELLOW}⚠️  WARNING: TODOs found in critical files:${NC}"
    echo "$CRITICAL_TODOS"
    echo "   Consider resolving these before committing."
fi

# Check for print() statements in new code
echo "🖨️  Checking for print() statements..."

PRINT_STATEMENTS=$(git diff --cached | grep -E "^\+.*print\(" 2>/dev/null || true)

if [ -n "$PRINT_STATEMENTS" ]; then
    echo -e "${YELLOW}⚠️  WARNING: print() statements detected in new code${NC}"
    echo "   Consider using AppLogger instead."
    echo ""
    echo "$PRINT_STATEMENTS"
fi

# Run Flutter analyze on staged files
echo "🔍 Running Flutter analyze..."

if command -v flutter &> /dev/null; then
    if ! flutter analyze --no-pub 2>&1 | grep -q "No issues found"; then
        echo -e "${YELLOW}⚠️  WARNING: Flutter analyze found issues${NC}"
        echo "   Run 'flutter analyze' to see details."
    else
        echo -e "${GREEN}✓ Flutter analyze passed${NC}"
    fi
fi

# Run tests if they exist
echo "🧪 Checking tests..."

if [ -d "test" ] && command -v flutter &> /dev/null; then
    # Only run tests if test files were modified
    if git diff --cached --name-only | grep -q "test/"; then
        echo "Running modified tests..."
        if ! flutter test 2>&1; then
            echo -e "${RED}❌ ERROR: Tests failed!${NC}"
            FOUND_ISSUES=true
        else
            echo -e "${GREEN}✓ Tests passed${NC}"
        fi
    fi
fi

# Final verdict
echo ""
if [ "$FOUND_ISSUES" = true ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ COMMIT BLOCKED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Critical security issues detected."
    echo "Please fix the issues above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
else
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}✓ Security checks passed!${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 0
fi
