# YachtMaster App Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_APP_ID=your-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Stripe Configuration (Client-side - Publishable Key Only)
STRIPE_PUBLISHABLE_KEY_DEV=pk_test_your_test_key
STRIPE_PUBLISHABLE_KEY_PROD=pk_live_your_live_key

# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id

# Environment
ENVIRONMENT=development # development | staging | production

# Feature Flags
ENABLE_CRYPTO_PAYMENTS=false
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true

# API URLs
API_BASE_URL_DEV=https://dev-api.yachtmaster.com
API_BASE_URL_STAGING=https://staging-api.yachtmaster.com
API_BASE_URL_PROD=https://api.yachtmaster.com

# Deep Linking
DEEP_LINK_SCHEME=yachtmaster
DEEP_LINK_HOST=app.yachtmaster.com

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Social Login
FACEBOOK_APP_ID=your-facebook-app-id
GOOGLE_CLIENT_ID_IOS=your-ios-client-id
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id

# Support
SUPPORT_EMAIL=support@yachtmaster.com
HELP_CENTER_URL=https://help.yachtmaster.com

# App Configuration
MIN_BOOKING_AMOUNT=100
MAX_BOOKING_AMOUNT=100000
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
PAYMENT_RETRY_ATTEMPTS=3

# Cache Configuration
CACHE_TTL_SECONDS=3600
IMAGE_CACHE_MAX_SIZE_MB=100

# Logging
LOG_LEVEL=debug # debug | info | warning | error
ENABLE_PERFORMANCE_LOGGING=true

# Security
ENABLE_ROOT_DETECTION=true
ENABLE_EMULATOR_DETECTION=true
ENABLE_SSL_PINNING=false # Set to true after implementing

# Testing
TEST_USER_EMAIL=test@yachtmaster.com
TEST_USER_PASSWORD=TestPassword123!
