# Firebase Functions Environment Variables Template
# Copy this file to .env for local development
# For production, use: firebase functions:config:set

# Stripe Configuration (Server-side - Secret Keys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_CONNECT_KEY=your_connect_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key

# Email Service (Optional)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@yachtmaster.com

# SMS Service (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Environment
NODE_ENV=development # development | production

# API Keys for External Services
GOOGLE_MAPS_API_KEY=your-server-side-maps-key
WEATHER_API_KEY=your-weather-api-key

# Database
FIRESTORE_EMULATOR_HOST=localhost:8080 # For local testing only

# Security
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Webhook URLs
PAYMENT_SUCCESS_WEBHOOK=https://your-app.com/webhooks/payment-success
PAYMENT_FAILED_WEBHOOK=https://your-app.com/webhooks/payment-failed

# Feature Flags
ENABLE_PAYMENT_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_RECEIPTS=true

# Logging
LOG_LEVEL=info # debug | info | warn | error
ENABLE_FUNCTION_LOGGING=true

# Monitoring
SENTRY_DSN=your-sentry-dsn # Optional error tracking
